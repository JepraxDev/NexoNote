<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for Android 11 and lower (API 30-).
   Managed backups and attachments already live inside the app and would duplicate the
   system backup or exceed its 25 MB quota, so they are excluded. The database, DataStore
   preferences and the rest of filesDir remain protected by the system.
-->
<full-backup-content>
    <exclude domain="file" path="backups" />
    <exclude domain="file" path="attachments" />
</full-backup-content>
