<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12+ (API 31+).
   Cloud backups skip managed backups and attachments to stay inside the 25 MB quota.
   Device transfer keeps attachments because there is no quota and the user expects a
   full migration; managed backups are still excluded because they can be recreated.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="backups" />
        <exclude domain="file" path="attachments" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="backups" />
    </device-transfer>
</data-extraction-rules>
